{
  "name": "csle-diagnostic",
  "displayName": "%cslediagnostic.display.name%",
  "description": "Diagnose whether the string literal expression contains Chinese characters, and can quickly fix them between simplified or traditional glyphs.",
  "version": "0.2.0",
  "icon": "icon.png",
  "publisher": "amlzq",
  "repository": {
    "type": "git",
    "url": "https://github.com/amlzq/csle-diagnostic"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:dart",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:json",
    "onLanguage:php",
    "onLanguage:python",
    "workspaceContains:**/*.{dart,js,mjs,cjs,ts,jsx,tsx,html,htm,css,json,php,py}"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "%cslediagnostic.display.name%",
      "properties": {
        "cslediagnostic.checkGlyph": {
          "type": "string",
          "order": 1,
          "default": "%cslediagnostic.simplified%",
          "enum": [
            "%cslediagnostic.simplified%",
            "%cslediagnostic.traditional.tw%",
            "%cslediagnostic.traditional.hk%",
            "%cslediagnostic.traditional%"
          ],
          "enumDescriptions": [
            "%cslediagnostic.simplified.desc%",
            "%cslediagnostic.traditional.tw.desc%",
            "%cslediagnostic.traditional.hk.desc%",
            "%cslediagnostic.traditional.desc%"
          ],
          "description": "%cslediagnostic.checkGlyph.desc%"
        },
        "cslediagnostic.convertGlyph": {
          "type": "string",
          "order": 2,
          "default": "%cslediagnostic.traditional.tw%",
          "enum": [
            "%cslediagnostic.simplified%",
            "%cslediagnostic.traditional.tw%",
            "%cslediagnostic.traditional.hk%",
            "%cslediagnostic.traditional%"
          ],
          "enumDescriptions": [
            "%cslediagnostic.simplified.desc%",
            "%cslediagnostic.traditional.tw.desc%",
            "%cslediagnostic.traditional.hk.desc%",
            "%cslediagnostic.traditional.desc%"
          ],
          "description": "%cslediagnostic.convertGlyph.desc%"
        },
        "cslediagnostic.checkLiteralExpression": {
          "type": "boolean",
          "order": 3,
          "default": true,
          "title": "%cslediagnostic.checkLiteralExpression.title%",
          "description": "%cslediagnostic.checkLiteralExpression.desc%"
        },
        "cslediagnostic.checkDocComment": {
          "type": "boolean",
          "order": 4,
          "default": false,
          "title": "%cslediagnostic.checkDocComment.title%",
          "description": "%cslediagnostic.checkDocComment.desc%"
        },
        "cslediagnostic.excludeNames": {
          "type": "array",
          "order": 5,
          "scope": "language-overridable",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%cslediagnostic.excludeNames.desc%"
        },
        "cslediagnostic.workspaceExclude": {
          "type": "array",
          "order": 6,
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%cslediagnostic.workspaceExclude.desc%"
        },
        "cslediagnostic.maxFileSize": {
          "type": "number",
          "order": 7,
          "default": 1024,
          "minimum": 1,
          "description": "%cslediagnostic.maxFileSize.desc%"
        },
        "cslediagnostic.previewBeforeApply": {
          "type": "boolean",
          "order": 8,
          "default": false,
          "description": "%cslediagnostic.previewBeforeApply.desc%"
        },
        "cslediagnostic.saveAfterApply": {
          "type": "boolean",
          "order": 9,
          "default": false,
          "description": "%cslediagnostic.saveAfterApply.desc%"
        },
        "cslediagnostic.autoDiagnosticOnOpen": {
          "type": "boolean",
          "order": 10,
          "default": false,
          "scope": "window",
          "description": "%cslediagnostic.autoDiagnosticOnOpen.desc%"
        },
        "cslediagnostic.autoDiagnosticMaxFiles": {
          "type": "number",
          "order": 11,
          "default": 5000,
          "minimum": 1,
          "scope": "window",
          "description": "%cslediagnostic.autoDiagnosticMaxFiles.desc%"
        },
        "cslediagnostic.customDictionary": {
          "type": "string",
          "order": 12,
          "default": "",
          "markdownDescription": "%cslediagnostic.customDictionary.desc%"
        }
      }
    },
    "languages": [
      {
        "id": "dart",
        "extensions": [
          ".dart"
        ],
        "aliases": [
          "Dart",
          "dart"
        ]
      },
      {
        "id": "javascript",
        "extensions": [
          ".js"
        ],
        "aliases": [
          "JavaScript",
          "javascript"
        ]
      },
      {
        "id": "javascriptreact",
        "extensions": [
          ".jsx"
        ],
        "aliases": [
          "JavaScript React",
          "jsx"
        ]
      },
      {
        "id": "typescript",
        "extensions": [
          ".ts"
        ],
        "aliases": [
          "TypeScript",
          "typescript"
        ]
      },
      {
        "id": "typescriptreact",
        "extensions": [
          ".tsx"
        ],
        "aliases": [
          "TypeScript React",
          "tsx"
        ]
      },
      {
        "id": "html",
        "extensions": [
          ".html",
          ".htm"
        ],
        "aliases": [
          "HTML",
          "html"
        ]
      },
      {
        "id": "css",
        "extensions": [
          ".css"
        ],
        "aliases": [
          "CSS",
          "css"
        ]
      },
      {
        "id": "json",
        "extensions": [
          ".json"
        ],
        "aliases": [
          "JSON",
          "json"
        ]
      },
      {
        "id": "php",
        "extensions": [
          ".php"
        ],
        "aliases": [
          "PHP",
          "php"
        ]
      },
      {
        "id": "python",
        "extensions": [
          ".py"
        ],
        "aliases": [
          "Python",
          "python"
        ]
      }
    ],
    "commands": [
      {
        "command": "cslediagnostic.importDictionary",
        "category": "%cslediagnostic.display.name%",
        "title": "%cslediagnostic.cmd.importDictionary%"
      },
      {
        "command": "cslediagnostic.openDictionaryTemplate",
        "category": "%cslediagnostic.display.name%",
        "title": "%cslediagnostic.cmd.openDictionaryTemplate%"
      },
      {
        "command": "cslediagnostic.diagnosticAllFiles",
        "category": "%cslediagnostic.display.name%",
        "title": "%cslediagnostic.cmd.diagnosticAllFiles%"
      },
      {
        "command": "cslediagnostic.diagnosticFolder",
        "category": "%cslediagnostic.display.name%",
        "title": "%cslediagnostic.cmd.diagnosticFolder%"
      },
      {
        "command": "cslediagnostic.rescan",
        "category": "%cslediagnostic.display.name%",
        "title": "%cslediagnostic.cmd.rescan%",
        "icon": "$(refresh)"
      },
      {
        "command": "cslediagnostic.clearResults",
        "category": "%cslediagnostic.display.name%",
        "title": "%cslediagnostic.cmd.clearResults%",
        "icon": "$(clear-all)"
      },
      {
        "command": "cslediagnostic.openFinding",
        "title": "%cslediagnostic.cmd.openFinding%"
      },
      {
        "command": "cslediagnostic.acceptAll",
        "category": "%cslediagnostic.display.name%",
        "title": "%cslediagnostic.cmd.acceptAll%",
        "icon": "$(check-all)"
      },
      {
        "command": "cslediagnostic.acceptFile",
        "category": "%cslediagnostic.display.name%",
        "title": "%cslediagnostic.cmd.acceptFile%",
        "icon": "$(check-all)"
      },
      {
        "command": "cslediagnostic.acceptItem",
        "category": "%cslediagnostic.display.name%",
        "title": "%cslediagnostic.cmd.acceptItem%",
        "icon": "$(check)"
      },
      {
        "command": "cslediagnostic.dismissItem",
        "category": "%cslediagnostic.display.name%",
        "title": "%cslediagnostic.cmd.dismissItem%",
        "icon": "$(close)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "cslediagnostic.results",
          "name": "%cslediagnostic.view.results%",
          "when": "cslediagnostic.hasResults"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "cslediagnostic.diagnosticFolder",
          "when": "false"
        },
        {
          "command": "cslediagnostic.openFinding",
          "when": "false"
        },
        {
          "command": "cslediagnostic.rescan",
          "when": "cslediagnostic.hasResults"
        },
        {
          "command": "cslediagnostic.clearResults",
          "when": "cslediagnostic.hasResults"
        },
        {
          "command": "cslediagnostic.acceptAll",
          "when": "cslediagnostic.hasResults"
        },
        {
          "command": "cslediagnostic.acceptFile",
          "when": "false"
        },
        {
          "command": "cslediagnostic.acceptItem",
          "when": "false"
        },
        {
          "command": "cslediagnostic.dismissItem",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "cslediagnostic.diagnosticFolder",
          "when": "explorerResourceIsFolder",
          "group": "7_modification@99"
        }
      ],
      "view/title": [
        {
          "command": "cslediagnostic.acceptAll",
          "when": "view == cslediagnostic.results",
          "group": "navigation@0"
        },
        {
          "command": "cslediagnostic.rescan",
          "when": "view == cslediagnostic.results",
          "group": "navigation@1"
        },
        {
          "command": "cslediagnostic.clearResults",
          "when": "view == cslediagnostic.results",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "cslediagnostic.acceptFile",
          "when": "view == cslediagnostic.results && viewItem == cslediagnostic.file",
          "group": "inline"
        },
        {
          "command": "cslediagnostic.acceptItem",
          "when": "view == cslediagnostic.results && viewItem == cslediagnostic.item",
          "group": "inline@1"
        },
        {
          "command": "cslediagnostic.dismissItem",
          "when": "view == cslediagnostic.results && viewItem == cslediagnostic.item",
          "group": "inline@2"
        },
        {
          "command": "cslediagnostic.acceptFile",
          "when": "view == cslediagnostic.results && viewItem == cslediagnostic.file",
          "group": "navigation"
        },
        {
          "command": "cslediagnostic.acceptItem",
          "when": "view == cslediagnostic.results && viewItem == cslediagnostic.item",
          "group": "navigation@1"
        },
        {
          "command": "cslediagnostic.dismissItem",
          "when": "view == cslediagnostic.results && viewItem == cslediagnostic.item",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "rm -rf out && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "rm -rf out && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "npm run compile && mocha"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^9.25.1",
    "mocha": "^10.8.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@babel/parser": "^7.28.6",
    "@babel/traverse": "^7.28.6",
    "@babel/types": "^7.28.6",
    "opencc-js": "^1.4.2",
    "tree-sitter-css": "^0.23.2",
    "tree-sitter-dart": "^1.0.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "vscode-nls": "^5.2.0",
    "web-tree-sitter": "^0.25.10"
  },
  "overrides": {
    "serialize-javascript": "^7.1.1"
  }
}
